<?xml version="1.0" encoding="utf-8"?>
<!-- IIS template WITHOUT secrets. `dotnet publish` fills in <aspNetCore>. The deploy job adds
     <environmentVariables> with an XML library (never string replacement). See docs/architecture/dotnet.md 15.1. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Crm.Web.dll" hostingModel="inprocess" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="1048576" />
          <fileExtensions allowUnlisted="true">
            <add fileExtension=".json" allowed="false" />
            <add fileExtension=".sql" allowed="false" />
            <add fileExtension=".config" allowed="false" />
            <add fileExtension=".env" allowed="false" />
            <add fileExtension=".pdb" allowed="false" />
          </fileExtensions>
          <hiddenSegments>
            <add segment="App_Data" />
            <add segment="logs" />
          </hiddenSegments>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <httpErrors existingResponse="PassThrough" />
      <webSocket enabled="false" />
    </system.webServer>
  </location>
</configuration>
