<?xml version="1.0" encoding="utf-8"?>
<!-- IIS template WITHOUT secrets. `dotnet publish` fills in <aspNetCore>. The deploy job adds
     <environmentVariables> with an XML library (never string replacement). See docs/architecture/dotnet.md 15.1.

     Deliberately minimal (proven on MonsterASP by the workflow's diagnose mode): the shared IIS rejects
     <security><requestFiltering> (HTTP 500.19, empty body) and the site stayed broken until it was removed.
     <httpErrors>, <httpProtocol>, <webSocket> and the <location> wrapper were removed too and are NOT re-added
     unless proven safe on the host (run the workflow with diagnose=true after changing this file).
     Safe to drop because handler path="*" sends EVERY request to ANCM, so IIS never serves files from disk (nothing
     like appsettings.json or web.config is reachable); request size limits and security headers are enforced
     by the app itself (Program.cs). -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\Crm.Web.dll" hostingModel="inprocess" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
  </system.webServer>
</configuration>
