@page "/auth/test-login"
@model TestLoginModel
@{ ViewData["Title"] = Model.ShowPicker ? "Choose a test user" : "Test sign-in"; Layout = "_SigninLayout"; }
@if (Model.ShowPicker)
{
  <h1>Choose a test user</h1>
  @if (Model.Users.Count == 0)
  {
  <p role="alert" class="error">No test users yet. Ask the developer to load the test users.</p>
  }
  else
  {
  <form method="post" asp-page="/Auth/TestLoginUser">
    <input type="hidden" name="returnTo" value="@Model.ReturnTo">
    <fieldset>
      <legend>Sign in as</legend>
      <div class="user-cards">
      @for (var i = 0; i < Model.Users.Count; i++)
      {
      var u = Model.Users[i];
      <label class="user-card"><input type="radio" name="oid" value="@u.Oid" checked="@(i == 0)">@Ui.Avatar(u.Name, "s36")<span class="who"><span>@u.Name</span><small>@u.Role · @(u.TeamName ?? "no team")</small></span></label>
      }
      </div>
    </fieldset>
    <button type="submit" class="button primary">Sign in</button>
  </form>
  }
}
else
{
  <h1>Test sign-in</h1>
  @if (Model.Locked)
  {
  <p role="alert" class="error">Too many incorrect attempts. Wait 15 minutes and try again.</p>
  }
  else
  {
  @if (Model.Error is not null){<p role="alert" class="error" id="e-code">@Model.Error</p>}
  <p>Enter the shared test access code.</p>
  <form method="post" asp-page="/Auth/TestLogin">
    <input type="hidden" name="returnTo" value="@Model.ReturnTo">
    <div class="field@(Model.Error is not null ? " has-error" : "")">
    <label for="code">Access code (required)</label>
    <input id="code" name="code" type="password" autocomplete="off" required @(Model.Error is not null ? "data-autofocus" : "") aria-invalid="@(Model.Error is not null ? "true" : null)" aria-describedby="@(Model.Error is not null ? "e-code" : null)">
    </div>
    <button type="submit" class="button primary">Continue</button>
  </form>
  }
}
