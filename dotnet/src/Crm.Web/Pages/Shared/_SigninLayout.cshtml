@using Crm.Web.Data
@inject BrandingCache Branding
@inject TimeProvider Clock
@{
    Layout = "_Layout";
    var branding = await Branding.GetAsync(Context.RequestAborted);
}
<div class="signin">
  <div class="signin-card">
    <div class="signin-logo">
@if (branding.LogoSha is not null)
{
      <img class="logo" src="/branding/logo?v=@branding.LogoSha[..12]" alt="@branding.AppName">
}
else
{
      <img class="logo-full logo-light" src="/img/brand/dafa-logo-softblue.svg" alt="DAFA" width="160" height="55">
      <img class="logo-full logo-dark" src="/img/brand/dafa-logo-negative.svg" alt="" width="160" height="55">
      <p class="tagline">Close to the markets – close to you</p>
}
    </div>
    <div class="signin-form">
@RenderBody()
    </div>
  </div>
  <p class="fine copyright">©@Clock.GetUtcNow().Year DAFA A/S</p>
</div>
