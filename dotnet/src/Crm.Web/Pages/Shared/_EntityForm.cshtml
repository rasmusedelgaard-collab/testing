@model Crm.Web.Pages.Entity.FormPage
@{
    var def = EntityDefinitions.Find(Model.Entity);
    var crumbs = new List<(string Label, string? Href)>();
    if (def is not null)
    {
        crumbs.Add((def.Plural, def.Path));
        if (Model.Cancel != def.Path){crumbs.Add((Model.Title.StartsWith("Edit ", StringComparison.Ordinal) ? Model.Title[5..] : Model.Title, Model.Cancel)); crumbs.Add(("Edit", null));}
        else{crumbs.Add((Model.Title, null));}
    }
}
@if (crumbs.Count > 0){<partial name="_Breadcrumb" model="crumbs" />}
<div class="page-header"><h1>@Model.Title</h1></div>
<partial name="_Flash" />
<partial name="_ErrorSummary" model="Model.Errors" />
<form method="post" action="@Model.Action" asp-antiforgery="true" class="form" novalidate>
  @if (Model.RowVer.Length > 0){<input type="hidden" name="rowVer" value="@Model.RowVer">}
  @foreach (var sec in Model.Sections)
  {
    <div class="form-group">
    @if (sec.Fieldset)
    {
      <fieldset><legend class="group-label">@sec.Title</legend>
      @foreach (var row in sec.Rows){<partial name="_Field" model="row[0]" />}
      </fieldset>
    }
    else
    {
      @if (sec.Title.Length > 0){<h2>@sec.Title</h2>}
      @foreach (var row in sec.Rows)
      {
        @if (row.Count == 2)
        {
        <div class="form-pair"><partial name="_Field" model="row[0]" /><partial name="_Field" model="row[1]" /></div>
        }
        else
        {
        <partial name="_Field" model="row[0]" />
        }
      }
    }
    </div>
  }
  <div class="actions">
    <button type="submit" class="button primary">Save</button>
    <a class="button quiet" href="@Model.Cancel">Cancel</a>
  </div>
</form>
