@model Crm.Web.Pages.Settings.ConfirmVm
<div class="confirm panel">
<h1>@Model.Title</h1>
<div class="alert @(Model.Danger ? "error" : "warn")">@Ui.Ring(Model.Danger ? "error" : "warning")<p>@Model.Message</p></div>
<form method="post" action="@Model.Action" asp-antiforgery="true">
  @foreach (var f in Model.Fields){<input type="hidden" name="@f.Name" value="@f.Value">}
  <div class="actions">
  <button type="submit" class="button @(Model.Danger ? "danger" : "primary")">@Model.Label</button>
  <a class="button quiet" href="@Model.Cancel">Cancel</a>
  </div>
</form>
</div>
