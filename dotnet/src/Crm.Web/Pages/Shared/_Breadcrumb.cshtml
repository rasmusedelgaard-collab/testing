@model IReadOnlyList<(string Label, string? Href)>
<nav aria-label="Breadcrumb" class="breadcrumb"><ol>
@for (var i = 0; i < Model.Count; i++)
{
  var (label, href) = Model[i];
  if (i == Model.Count - 1 || href is null){<li aria-current="page">@label</li>}else{<li><a href="@href">@label</a></li>}
}
</ol></nav>
