@page "/{entity:crmentity}"
@model IndexModel
@if (Model.Form is not null)
{
    <partial name="_EntityForm" model="Model.Form" />
}
else
{
var def = Model.Def;
var q = Model.Q;
<div class="page-header">
  <h1>@def.Plural (@Model.Total)</h1>
  <a class="button primary" href="@def.Path/new">New @def.Singular</a>
</div>
<form class="filters" method="get" action="@def.Path">
  <div class="field"><label for="f-q">Search</label><input id="f-q" name="q" type="search" value="@q.Q" maxlength="100"></div>
  @foreach (var f in Model.Filters)
  {
  <div class="field"><label for="f-@f.Name">@f.Label</label>
    <select id="f-@f.Name" name="@f.Name">
      @foreach (var o in f.Options){<option value="@o.Value" selected="@(o.Value == f.Value)">@o.Label</option>}
    </select></div>
  }
  <input type="hidden" name="sort" value="@q.Sort"><input type="hidden" name="dir" value="@q.Dir">
  <div class="field"><label for="pageSize">Rows</label>
    <select id="pageSize" name="pageSize">@foreach (var n in EntityDefinitions.PageSizes){<option value="@n" selected="@(n == q.PageSize)">@n</option>}</select></div>
  <button type="submit" class="button secondary">Apply</button>
  <a href="@def.Path">Clear filters</a>
</form>
<p role="status" class="muted">@Model.Total @(Model.Total == 1 ? def.Singular : def.Plural.ToLowerInvariant()) found</p>
@if (Model.Rows.Count == 0)
{
  @if (Model.IsFiltered)
  {
  <p>No @def.Plural.ToLowerInvariant() match these filters.</p><p><a class="button secondary" href="@def.Path">Clear filters</a></p>
  }
  else
  {
  <p>No @def.Plural.ToLowerInvariant() yet.</p><p><a class="button primary" href="@def.Path/new">New @def.Singular</a></p>
  }
}
else
{
<div class="table-wrap">
<table class="data">
  <caption class="visually-hidden">@def.Plural</caption>
  <thead><tr>
    @foreach (var c in Model.Heads)
    {
    <th scope="col" aria-sort="@(c.Href is not null ? c.Aria : null)">@if (c.Href is not null){<a href="@c.Href">@c.Label</a>}else{@c.Label}</th>
    }
  </tr></thead>
  <tbody>
  @foreach (var cells in Model.Rows)
  {
  <tr>
    @for (var ci = 0; ci < cells.Count; ci++)
    {
    var c = cells[ci];
    <td data-label="@Model.Heads[ci].Label" class="@(c.Right ? "num" : null)">
      @if (c.DoneForm is not null)
      {
      <form method="post" action="@c.DoneForm.Action" asp-antiforgery="true" class="inline-form">
        <input type="hidden" name="returnTo" value="@c.DoneForm.ReturnTo">
        <button type="submit" class="button link">@(c.DoneForm.Checked ? "☑ Done" : "☐ Mark done")<span class="visually-hidden">: @c.DoneForm.Context</span></button>
      </form>
      }
      else if (c.Href is not null){<a href="@c.Href">@c.Text</a>}else{@c.Text}
      @if (c.Note is not null){<br><span class="badge warn">@c.Note</span>}
    </td>
    }
  </tr>
  }
  </tbody>
</table>
</div>
<nav class="pagination" aria-label="Pagination">
  <span>Showing @Model.From–@Model.To of @Model.Total</span>
  @if (Model.PrevHref is not null){<a class="button secondary" href="@Model.PrevHref">Previous</a>}
  <span>Page @Model.PageNo of @Model.PageCount</span>
  @if (Model.NextHref is not null){<a class="button secondary" href="@Model.NextHref">Next</a>}
</nav>
}
}
