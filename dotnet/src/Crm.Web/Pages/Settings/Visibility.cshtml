@page "/settings/visibility"
@model VisibilityModel
<partial name="_SettingsNav" model='"visibility"' />
@if (Model.Confirm is not null)
{
    <partial name="_SettingsConfirm" model="Model.Confirm" />
}
else
{
<h1>Visibility</h1>
<partial name="_ErrorSummary" model="Model.Summary" />
<form method="post" action="/settings/visibility" asp-antiforgery="true" class="form">
  <fieldset><legend>Who can see records</legend>
    <label class="inline"><input type="radio" name="mode" value="private" checked="@(Model.Mode == "private")"> Private: users see only the records they own.</label><br>
    <label class="inline"><input type="radio" name="mode" value="team" checked="@(Model.Mode == "team")"> Team: users see and edit all records owned by their team. Only the owner, Managers and Admins can delete.</label>
  </fieldset>
  <p class="muted">Managers always see their team's records. Admins see all records.</p>
  <div class="actions"><button type="submit" class="button primary">Save</button></div>
</form>
}
