@page "/settings/general/{handler:regex(^logo$)?}"
@model GeneralModel
<h1>General</h1>
<partial name="_Flash" />
<partial name="_ErrorSummary" model="Model.Summary" />
<form method="post" action="/settings/general" asp-antiforgery="true" class="form" novalidate>
  <div class="field@(Model.Errors.ContainsKey("appName") ? " has-error" : "")">
    <label for="f-appName">CRM name (required)</label>
    @if (Model.Errors.TryGetValue("appName", out var e1)){<span class="field-error" id="e-appName">@Ui.Icon("error")@e1</span>}
    <input id="f-appName" name="appName" type="text" maxlength="40" required value="@Model.AppName" aria-invalid="@(Model.Errors.ContainsKey("appName") ? "true" : null)" aria-describedby="@(Model.Errors.ContainsKey("appName") ? "e-appName" : null)">
  </div>
  <div class="field@(Model.Errors.ContainsKey("accentColor") ? " has-error" : "")">
    <label for="f-accentColor">Accent colour</label>
    <span class="help" id="h-accentColor">Used for links and buttons in the Light theme. It must have a contrast of at least 4.5:1 against white and the light gray panels (#D6D7D7). The Dark theme always uses white.</span>
    @if (Model.Errors.TryGetValue("accentColor", out var e2)){<span class="field-error" id="e-accentColor">@Ui.Icon("error")@e2</span>}
    <div class="actions"><input id="f-accentColor" name="accentColor" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" value="@Model.AccentColor" aria-describedby="h-accentColor@(Model.Errors.ContainsKey("accentColor") ? " e-accentColor" : "")" aria-invalid="@(Model.Errors.ContainsKey("accentColor") ? "true" : null)"><span class="swatch" aria-hidden="true"></span></div>
  </div>
  <div class="actions"><button type="submit" class="button primary">Save</button></div>
</form>
<section aria-labelledby="preview-h" class="panel">
  <h2 id="preview-h">Brand preview</h2>
  <p class="muted">The saved colour on both themes. The Dark theme keeps white.</p>
  <div class="preview-row">
    <div class="preview-sample light"><strong>Light</strong><span class="sample-button">Primary button</span><span class="sample-link">A link</span></div>
    <div class="preview-sample dark"><strong>Dark</strong><span class="sample-button">Primary button</span><span class="sample-link">A link</span></div>
  </div>
</section>
<h2>Logo</h2>
@if (Model.LogoSha is not null){<p><img class="logo-preview" src="/branding/logo?v=@Model.LogoSha[..12]" alt="Current logo" height="48"></p>}else{<p class="muted">No logo uploaded.</p>}
<form method="post" action="/settings/general/logo" enctype="multipart/form-data" asp-antiforgery="true" class="form">
  <div class="field@(Model.Errors.ContainsKey("logo") ? " has-error" : "")">
    <label for="f-logo">Logo file (PNG, 500 KB or smaller)</label>
    @if (Model.Errors.TryGetValue("logo", out var e3)){<span class="field-error" id="e-logo">@Ui.Icon("error")@e3</span>}
    <input id="f-logo" name="logo" type="file" accept="image/png" aria-invalid="@(Model.Errors.ContainsKey("logo") ? "true" : null)" aria-describedby="@(Model.Errors.ContainsKey("logo") ? "e-logo" : null)">
  </div>
  <div class="actions"><button type="submit" class="button secondary">Upload logo</button></div>
</form>
