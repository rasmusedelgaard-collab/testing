@page "/error/{code:int?}"
@using Crm.Web.Data
@model ErrorModel
@inject BrandingCache Branding
@{
    ViewData["Title"] = Model.PageTitle;
    var branding = await Branding.GetAsync(Model.HttpContext.RequestAborted);
    if (Model.Kind == ErrorKind.Waking) { ViewData["Bare"] = true; }
}
@if (Model.Kind == ErrorKind.Waking)
{
<div class="system-page">
@Ui.Ornament()
<div class="wake" id="wake" data-post="@(Model.IsPost ? "true" : "false")">
  <a class="brand" href="/" aria-label="@branding.AppName, go to dashboard">
  @if (branding.LogoSha is not null){<img class="logo" src="/branding/logo?v=@branding.LogoSha[..12]" alt="">}
  else{<img class="logo-full logo-light" src="/img/brand/dafa-logo-primary-blue.svg" alt="" width="160" height="55"><img class="logo-full logo-dark" src="/img/brand/dafa-logo-negative.svg" alt="" width="160" height="55">}
  </a>
  <h1>Waking up the database</h1>
  <p>The CRM pauses its database when no one has used it for a while. It's starting up again, which can take up to a minute.</p>
  <p class="js-only">This page will continue by itself.</p>
  <p class="no-js-only">Wait a minute, then choose Try again.</p>
  @if (Model.IsPost){<p><strong>Your changes weren't saved.</strong> Go back to the form to try again.</p>}
  <div class="indeterminate" aria-hidden="true"></div>
  <p id="wake-status" role="status">Still waking up.</p>
  <p id="wake-giveup" class="alert error" role="alert" tabindex="-1" hidden>@Ui.Ring("error")This is taking longer than usual. Try again, or contact your administrator if this continues. Reference: @Model.Reference</p>
  @if (Model.IsPost){<a class="button primary" id="wake-back" href="/">Go to dashboard</a>}else{<a class="button primary" id="wake-retry" href="">Try again now</a>}
</div>
</div>
<script src="/js/wake.js" defer></script>
}
else
{
<div class="system-page">
@Ui.Ornament()
<div class="system-block">
@if (Model.Kind == ErrorKind.Conflict)
{
  @Ui.Ring("warning", "r56")
  <h1>Someone else changed this record</h1>
  <p>Someone else changed this record while you were editing. Review their changes, then save again. Your edits were not saved.</p>
  <p class="muted">Reference: @Model.Reference</p>
  <p><a class="button primary" href="@Model.RecordPath">Show the current version</a></p>
}
else
{
  @Ui.Ring(Model.Status == 404 ? "search" : Model.Status is 403 ? "error" : "warning", "r56")
  <h1>@Model.Heading</h1>
  <p>@Model.Message</p>
  <p class="muted">Reference: @Model.Reference</p>
  <div class="actions">
    @if (Model.Status >= 500 && !Model.IsPost){<a class="button primary" href="">Try again</a>}
    <a class="button @(Model.Status >= 500 && !Model.IsPost ? "secondary" : "primary")" href="/">Go to dashboard</a>
    @if (Model.Status == 404){<a class="button secondary" href="/search">Search</a>}
  </div>
}
</div>
</div>
}
