<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Crm.Web</RootNamespace>
    <AssemblyName>Crm.Web</AssemblyName>
    <AddServerHeader>false</AddServerHeader>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PreserveCompilationContext>false</PreserveCompilationContext>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Crm.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="Dapper" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../db/migrations/*.sql" LogicalName="migrations/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../db/seed/test-users.sql" LogicalName="seed/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
