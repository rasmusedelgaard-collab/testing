<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for MonsterASP.NET (Windows / IIS + iisnode). Contains NO secrets and must never get any:
  configuration is read from a separate, non-committed file by iisnode-entry.js (see docs/deploy/monsterasp.md).

  Only iisnode-entry.js (which loads dist/server.js) is a handler. Every request URL is rewritten to it, so IIS never
  serves a file from disk (src/, node_modules/, db/, .env*, *.ts, *.map, web.config...). The Express app serves its own
  static assets from dist/public. Request filtering below is a second line of defence.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />

    <handlers>
      <add name="iisnode" path="iisnode-entry.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="app" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="iisnode-entry.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="src" />
          <add segment="db" />
          <add segment="iisnode" />
          <add segment="dist" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".ts" allowed="false" />
          <add fileExtension=".map" allowed="false" />
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".yml" allowed="false" />
          <add fileExtension=".json" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Let the app's own error pages through instead of IIS replacing them. -->
    <httpErrors existingResponse="PassThrough" />

    <iisnode
      enableXFF="true"
      loggingEnabled="false"
      devErrorsEnabled="false"
      debuggingEnabled="false"
      logDirectory="iisnode"
      watchedFiles="web.config;iisnode-entry.js;dist\server.js"
      gracefulShutdownTimeout="10000"
    />
    <!--
      To debug a startup failure temporarily set loggingEnabled="true" (logs go to the iisnode\ folder, readable via the
      control panel file manager), then set it back to "false". devErrorsEnabled must stay "false": it prints stack
      traces to browsers.

      Node version: nodeProcessCommandLine is left at the iisnode default (the host's node.exe on PATH, chosen in the
      MonsterASP control panel). To pin a specific install, add this attribute to the iisnode element above, using the
      path MonsterASP documents for your Node version:
        nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
    -->
  </system.webServer>
</configuration>
