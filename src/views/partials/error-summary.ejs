<% const items = (locals.summary || []).map((x) => typeof x === 'string' ? { field: '', message: x } : x); %>
<% if (items.length) { %>
<div class="error-summary" role="alert" tabindex="-1" id="error-summary">
  <h2>Fix <%= items.length %> problem<%= items.length === 1 ? '' : 's' %> to save</h2>
  <ul><% items.forEach((e) => { %><li><% if (e.field) { %><a href="#f-<%= e.field %>"><%= e.message %></a><% } else { %><%= e.message %><% } %></li><% }) %></ul>
</div>
<% } %>
<% if (locals.note) { %><p class="flash" role="status"><%= note %></p><% } %>
