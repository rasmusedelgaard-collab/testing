# Reference for the settings the deploy workflow writes into crm.env (from GitHub Environment test secrets/variables).
# Not used directly; kept so the variable names are documented. Never commit a real crm.env.
NODE_ENV=production
AUTH_MODE=test-access-code
REDIRECT_URI=https://crmtest.runasp.net/auth/redirect
# Number of proxies in front of the app (IIS = 1). Wrong value breaks client IPs and rate limits.
TRUST_PROXY=1
LOG_LEVEL=info

DB_AUTH_MODE=sql-password
# EITHER the host's ADO.NET connection string (one secret) ...
# DB_CONNECTION_STRING=Server=...;Database=...;User Id=...;Password=...;
# ... OR the split variables below. Setting both is a startup error.
DB_SERVER=db81053.databaseasp.net
DB_NAME=db81053
DB_USER=db81053
# Only set DB_TRUST_SERVER_CERT=true if the connection fails with a certificate error.
# DB_TRUST_SERVER_CERT=true

# SECRETS (fill in; generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
DB_PASSWORD=
SESSION_SECRET=
TEST_ACCESS_CODE=

# Optional named test Admin, created by the seed step (db:seed:test) and offered by the test-login picker.
# Both or neither; empty means unset. No password exists: access is via TEST_ACCESS_CODE. Not needed at runtime
# (the picker reads the database), but harmless there.
# TEST_ADMIN_NAME=
# TEST_ADMIN_EMAIL=
