<%- include('../partials/head') %>
<nav aria-label="Breadcrumb" class="breadcrumb"><a href="<%= def.path %>"><%= def.plural %></a> / <span aria-current="page"><%= name %></span></nav>
<div class="page-header">
  <h1><%= name %></h1>
  <div class="actions">
    <% if (doneAction) { %>
    <form method="post" action="<%= doneAction.action %>" class="inline-form"><%- csrfField() %><input type="hidden" name="returnTo" value="<%= doneAction.returnTo %>"><button type="submit" class="button secondary"><%= doneAction.label %></button></form>
    <% } %>
    <a class="button secondary" href="<%= def.path %>/<%= row.Id %>/edit">Edit</a>
    <% if (canDelete) { %><a class="button danger" href="<%= def.path %>/<%= row.Id %>/delete">Delete <%= def.singular %></a><% } %>
  </div>
</div>
<p>Owner: <strong><%= row.OwnerName %></strong></p>
<section aria-labelledby="details-h">
  <h2 id="details-h">Details</h2>
  <dl class="details">
    <% details.forEach((d) => { %>
    <dt><%= d.label %></dt>
    <dd><% if (!d.text) { %><span aria-hidden="true">–</span><span class="visually-hidden">Not set</span><% } else if (d.href) { %><a href="<%= d.href %>"><%= d.text %></a><% } else { %><%= d.text %><% } %></dd>
    <% }) %>
  </dl>
</section>
<% if (stageActions) { %>
<section aria-labelledby="stage-h" class="stage-actions">
  <h2 id="stage-h">Close this opportunity</h2>
  <form method="post" action="<%= def.path %>/<%= row.Id %>/won" class="inline-form"><%- csrfField() %><input type="hidden" name="rowVer" value="<%= stageActions.rowVer %>"><button type="submit" class="button secondary">Mark as won</button></form>
  <form method="post" action="<%= def.path %>/<%= row.Id %>/lost" class="inline-form"><%- csrfField() %><input type="hidden" name="rowVer" value="<%= stageActions.rowVer %>">
    <label for="lostReason">Lost reason (required to mark as lost)</label>
    <% if (stageActions.lostError) { %><span class="field-error" id="e-lostReason"><span aria-hidden="true">⚠ </span><%= stageActions.lostError %></span><% } %>
    <select id="lostReason" name="lostReason"<%- stageActions.lostError ? ' aria-invalid="true" aria-describedby="e-lostReason"' : '' %>><option value="">— choose —</option><% stageActions.lostReasons.forEach((p) => { %><option value="<%= p.id %>"><%= p.label %></option><% }) %></select>
    <button type="submit" class="button secondary">Mark as lost</button></form>
</section>
<% } %>
<% if (tabs.length) { %>
<section aria-labelledby="rel-h">
  <h2 id="rel-h">Related records</h2>
  <nav aria-label="Related records" class="tabs"><ul>
    <% tabs.forEach((t) => { %><li><a href="<%= t.href %>"<%- t.active ? ' aria-current="page"' : '' %>><%= t.label %> (<%= t.count %>)</a></li><% }) %>
  </ul></nav>
  <% if (tabTable) { %>
  <p><a class="button secondary" href="<%= tabTable.newHref %>"><%= tabTable.newLabel %></a></p>
  <% if (tabTable.rows.length === 0) { %><p class="muted">Nothing here yet.</p><% } else { %>
  <div class="table-wrap"><table class="data">
    <caption class="visually-hidden"><%= tabTable.title %></caption>
    <thead><tr><% tabTable.columns.forEach((c) => { %><th scope="col"><%= c %></th><% }) %></tr></thead>
    <tbody><% tabTable.rows.forEach((r) => { %><tr><% r.cells.forEach((c, ci) => { %><td data-label="<%= tabTable.columns[ci] %>"<%- c.right ? ' class="num"' : '' %>>
      <% if (c.doneForm) { %><form method="post" action="<%= c.doneForm.action %>" class="inline-form"><%- csrfField() %><input type="hidden" name="returnTo" value="<%= c.doneForm.returnTo %>"><button type="submit" class="button link"><%= c.doneForm.checked ? '☑ Done' : '☐ Mark done' %><span class="visually-hidden">: <%= c.doneForm.context %></span></button></form>
      <% } else if (c.href) { %><a href="<%= c.href %>"><%= c.text %></a><% } else { %><%= c.text %><% } %>
      <% if (c.note) { %><br><span class="badge warn"><%= c.note %></span><% } %></td><% }) %></tr><% }) %></tbody>
  </table></div>
  <% } %>
  <% } %>
</section>
<% } %>
<section aria-labelledby="hist-h" class="history">
  <h2 id="hist-h">History</h2>
  <% if (history.length === 0) { %><p class="muted">No changes recorded yet.</p><% } else { %>
  <ol class="timeline">
    <% history.forEach((h) => { %>
    <li><span class="muted"><%= h.at %></span> · <%= h.by %>: <% if (h.owner) { %><strong><%= h.text %></strong><% } else { %><%= h.text %><% } %></li>
    <% }) %>
  </ol>
  <% } %>
</section>
<footer class="record-footer muted">
  Created <%= modified.createdAt %> by <%= modified.createdBy %>
  <% if (modified.edited) { %> · Last modified by <%= modified.by %>, <%= modified.at %><% } %>
</footer>
<%- include('../partials/foot') %>
