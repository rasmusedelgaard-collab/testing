<%- include('../partials/head') %>
<div class="center-card" id="wake" data-post="<%= isPost ? 'true' : 'false' %>">
  <h1>Waking up the database</h1>
  <p>The CRM pauses its database when no one has used it for a while. It's starting up again, which can take up to a minute.</p>
  <p class="js-only">This page will continue by itself.</p>
  <p class="no-js-only">Wait a minute, then choose Try again.</p>
  <% if (isPost) { %><p><strong>Your changes weren't saved.</strong> Go back to the form to try again.</p><% } %>
  <div class="indeterminate" aria-hidden="true"></div>
  <p id="wake-status" role="status">Still waking up.</p>
  <p id="wake-giveup" role="alert" hidden>This is taking longer than usual. Try again, or contact your administrator if this continues. Reference: <%= reference %></p>
  <% if (isPost) { %>
  <a class="button primary" href="javascript:history.back()">Go back</a>
  <% } else { %>
  <a class="button primary" id="wake-retry" href="">Try again now</a>
  <% } %>
</div>
<script src="/js/wake.js" defer></script>
<%- include('../partials/foot') %>
