# Copy to .env for local development. Never commit real values.
NODE_ENV=development
# Run without Entra or SQL (fake signed-in user, in-memory sessions). Refused when NODE_ENV=production.
DEMO_MODE=true
PORT=3000
REDIRECT_URI=http://localhost:3000/auth/redirect
LOG_LEVEL=info

# Required when DEMO_MODE is not true:
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=
# SESSION_SECRET=at-least-32-random-characters-long-string
# DB_SERVER=your-server.database.windows.net
# DB_NAME=crm
# DB_AUTH_MODE=default-azure        # managed-identity | default-azure | sql-password
# DB_USER=                          # sql-password only
# DB_PASSWORD=                      # sql-password only
