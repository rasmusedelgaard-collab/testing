{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "description": "Internal CRM (Express + EJS, Azure SQL with Row-Level Security, Entra ID sign-in)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "e2e": "node e2e/demo.e2e.cjs && node e2e/crm.e2e.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed:test": "tsx --env-file-if-exists=.env scripts/migrate.ts seed-test"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.2",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mssql": "^12.7.14",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "chart.js": "^4.6.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
